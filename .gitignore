## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Local database files (may contain accounts, credentials, or player data)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# SEC-05 受保护服务端秘密属于绑定机器与账号的运行时数据。
**/Configs/ProtectedSecrets/
*.dpapi

# RELEASE-01 签名私钥、APK keystore 与口令只存在于受保护存储。
**/Configs/ReleaseSecrets/
*.keystore
*.jks

# OPS-BASIC-03 远程开关是运行时状态，不作为发布默认值提交。
**/Configs/Operations/kill-switches.json
**/Configs/Operations/kill-switches.json.partial-*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# Visual Studio per-user state and publish settings
*.csproj.user
*.slnLaunch.user
*.pubxml.user

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# The server scripting debugger is source code, not a build output directory.
!/Server/Scripting/Debug/
/Server/Scripting/Debug/*
!/Server/Scripting/Debug/*.cs

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# BASE-02 authorized external/generated resource targets (never commit GB-sized assets).
# Android Micro mode ships only the small bootstrap metadata/core set below;
# keep the rest of the acquired resource tree local-only.
/Client_MonoGame.Shared/BootstrapAssets/**
!/Client_MonoGame.Shared/BootstrapAssets/bootstrap-assets.txt
!/Client_MonoGame.Shared/BootstrapAssets/bootstrap-package-index.json
!/Client_MonoGame.Shared/BootstrapAssets/bootstrap-packages.json
!/Client_MonoGame.Shared/BootstrapAssets/Language.ini
!/Client_MonoGame.Shared/BootstrapAssets/Mir2Config.ini
!/Client_MonoGame.Shared/BootstrapAssets/bootstrap-package-manifests/
!/Client_MonoGame.Shared/BootstrapAssets/bootstrap-package-manifests/*.json
!/Client_MonoGame.Shared/BootstrapAssets/Data/
!/Client_MonoGame.Shared/BootstrapAssets/Data/ChrSel.Lib
!/Client_MonoGame.Shared/BootstrapAssets/Data/Prguse.Lib
!/Client_MonoGame.Shared/BootstrapAssets/Data/Title.Lib
!/Client_MonoGame.Shared/BootstrapAssets/Sound/
!/Client_MonoGame.Shared/BootstrapAssets/Sound/100.wav
!/Client_MonoGame.Shared/BootstrapAssets/Sound/Log-in-long2.wav
!/Client_MonoGame.Shared/BootstrapAssets/Sound/sellect-loop2.wav
!/Client_MonoGame.Shared/BootstrapAssets/Sound/SoundList.lst
/Build/Client_VorticeDX11/**
/Build/Mobile/BootstrapRepo/**
!/Build/Mobile/BootstrapRepo/
!/Build/Mobile/BootstrapRepo/Packages/
!/Build/Mobile/BootstrapRepo/Packages/core-startup.zip
!/Build/Mobile/BootstrapRepo/Packages/core-startup.zip.sha256
